BACKEND_API_URL="http://localhost:3000"

# Optional. Direct download link for the packaged desktop agent .exe (e.g. an S3 object URL).
# Public by design — not a secret, and deliberately NOT proxied through the backend (a large
# binary through a Vercel serverless function risks hitting response size/timeout limits).
