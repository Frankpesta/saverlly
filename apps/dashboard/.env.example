BACKEND_API_URL="http://localhost:3000"

# The agent download link and the support email used to live here as NEXT_PUBLIC_* variables.
# Both are read from the backend at runtime now, because NEXT_PUBLIC_* is baked in at build
# time and changing either one meant redeploying the frontend:
#   - agent installer: backend AGENT_DOWNLOAD_URL / AGENT_RELEASE_DIR
#   - support email:   admin console, Settings > Platform
