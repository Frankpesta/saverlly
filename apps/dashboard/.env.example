BACKEND_API_URL="http://localhost:3000"

# Optional. Direct download link for the packaged desktop agent .exe (e.g. an S3 object URL).
# Public by design — not a secret, and deliberately NOT proxied through the backend (a large
# binary through a Vercel serverless function risks hitting response size/timeout limits).
# Leave unset to show an honest "not available yet" toast instead of a broken link.
NEXT_PUBLIC_AGENT_DOWNLOAD_URL=""

# Optional. Support inbox shown to kiosk owners as a "Contact your Saverlly admin" mailto
# link in the portal Settings page. Leave unset to show the same text as plain, non-linked
# copy instead of a mailto: link to a real, needs-a-real-address-from-the-client inbox.
NEXT_PUBLIC_SUPPORT_EMAIL=""
