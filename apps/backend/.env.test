# Dedicated database for integration tests — never the dev DB, so test runs
# never depend on or clobber whatever state happens to be sitting in dev.
DATABASE_URL="postgresql://saverlly:saverlly_dev_password@localhost:5432/saverlly_test?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="test_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test_refresh_secret"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3001
