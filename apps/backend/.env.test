# Dedicated database for integration tests — never the dev DB, so test runs
# never depend on or clobber whatever state happens to be sitting in dev.
DATABASE_URL="postgresql://saverlly:saverlly_dev_password@localhost:5432/saverlly_test?schema=public"
# DB index 1 (dev uses the default, 0) — keeps test-run BullMQ queues/jobs fully isolated from dev.
REDIS_URL="redis://localhost:6379/1"

JWT_ACCESS_SECRET="test_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test_refresh_secret"
JWT_REFRESH_EXPIRES_IN="30d"

ENCRYPTION_KEY="PVLiXAm1IpFh8zaDI8ARV09h/UE1wPru/ED9if/Qtyo="

PORT=3001

# e2e tests exercise the affiliate sync job against the mock adapter (see scrape-sync-jobs.e2e-spec.ts).
AFFILIATE_MOCK_ADAPTERS_ENABLED="true"

COMMISSION_PENDING_WINDOW_DAYS="90"

# STRIPE_SECRET_KEY is intentionally unset — no real Stripe test account configured in
# this dev sandbox yet, so onboarding-link/transfer-creation e2e tests are deferred until
# one exists (see 05-PHASE-5 memory). STRIPE_WEBHOOK_SECRET below is a fake value used only
# to locally sign+verify webhook payloads in tests via Stripe's own generateTestHeaderString
# helper — that's pure HMAC, no network call, so it doesn't need to be a real Stripe secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_test_local_signing_secret"
STRIPE_CONNECT_RETURN_URL="http://localhost:3001/dashboard/payouts"
STRIPE_CONNECT_REFRESH_URL="http://localhost:3001/dashboard/payouts"

PAYOUT_AGGREGATION_INTERVAL_DAYS="30"
