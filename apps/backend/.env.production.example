# Copy to .env.production on the EC2 box (docker-compose.prod.yml's backend service reads it
# via env_file). Same shape as .env.example — comments below call out what actually changes
# for this testing deploy. See DEPLOYMENT.md for the full runbook.

# RDS endpoint, not local Postgres. Get this from the RDS instance's "Endpoint" in the AWS
# console after it's created (step 1 of DEPLOYMENT.md).
DATABASE_URL="postgresql://saverlly:<rds-password>@<rds-endpoint>.rds.amazonaws.com:5432/saverlly?schema=public"

# Redis runs as a sibling container on the same box (docker-compose.prod.yml) — "redis" is
# the compose service name, resolvable via Docker's internal DNS.
REDIS_URL="redis://redis:6379"

# Generate real secrets, don't reuse the dev placeholders:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me"
JWT_REFRESH_EXPIRES_IN="30d"

# AES-256 key (32 bytes, base64) — generate with the same command as above, a different value.
ENCRYPTION_KEY="change_me"

PORT=3000
NODE_ENV="production"

# This box's own publicly-reachable address (the EC2 instance's Elastic IP). Used to build
# absolute URLs for uploaded files. No domain yet, so this is plain HTTP — revisit once one
# exists (see DEPLOYMENT.md's "known limitations").
PUBLIC_BACKEND_URL="http://<elastic-ip>:3000"

# No real affiliate credentials exist yet — keep the mock adapter on for testing, same as dev.
AFFILIATE_MOCK_ADAPTERS_ENABLED="true"

COMMISSION_PENDING_WINDOW_DAYS="90"

# Leave blank unless you have real Stripe test-mode credentials to hand — Stripe calls just
# fail explicitly with these unset, nothing silently breaks.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# The deployed dashboard's real Vercel domain, not localhost.
STRIPE_CONNECT_RETURN_URL="https://<your-app>.vercel.app/portal/earnings"
STRIPE_CONNECT_REFRESH_URL="https://<your-app>.vercel.app/portal/earnings"

PAYOUT_AGGREGATION_INTERVAL_DAYS="30"

# Leave RESEND_API_KEY unset to log emails instead of sending them for real — same fallback
# behavior as dev.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Saverlly <onboarding@resend.dev>"

# The deployed dashboard's real Vercel domain — used for absolute links inside emails.
DASHBOARD_BASE_URL="https://<your-app>.vercel.app"
