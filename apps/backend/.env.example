# Copy to .env and adjust as needed. Local values here match repo-root docker-compose.yml defaults.
DATABASE_URL="postgresql://saverlly:saverlly_dev_password@localhost:5432/saverlly?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me"
JWT_REFRESH_EXPIRES_IN="30d"

# AES-256 key (32 bytes, base64) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change_me"

PORT=3000

# The backend's own publicly-reachable base URL — used to build absolute URLs for uploaded
# files (e.g. announcement images) rather than trusting a client-supplied Host header.
PUBLIC_BACKEND_URL="http://localhost:3000"

# Set to "true" in dev/staging to let the affiliate sync job use the mock adapter
# for merchants with no real per-network adapter yet. Leave unset in production —
# otherwise fabricated MOCK coupons get persisted as active API coupons.
AFFILIATE_MOCK_ADAPTERS_ENABLED="true"

# How far back the commission ingestion job looks for un-ingested AttributionAttempts
# before giving up on them ever converting. Platform-wide default — override per network
# from the network's own reporting window where available (typically 30-90 days).
COMMISSION_PENDING_WINDOW_DAYS="90"

# Stripe Connect (Phase 5 payouts) — test-mode keys for dev/staging
STRIPE_SECRET_KEY="change_me"
STRIPE_WEBHOOK_SECRET="change_me"
# Where the kiosk-owner's browser lands after completing/refreshing Stripe Connect onboarding
STRIPE_CONNECT_RETURN_URL="http://localhost:3001/portal/earnings"
STRIPE_CONNECT_REFRESH_URL="http://localhost:3001/portal/earnings"

# Cadence for the payout aggregation job, in days — default monthly
PAYOUT_AGGREGATION_INTERVAL_DAYS="30"
