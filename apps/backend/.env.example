# Copy to .env and adjust as needed. Local values here match repo-root docker-compose.yml defaults.
DATABASE_URL="postgresql://saverlly:saverlly_dev_password@localhost:5432/saverlly?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me"
JWT_REFRESH_EXPIRES_IN="30d"

# AES-256 key (32 bytes, base64) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change_me"

PORT=3000

# Set to "true" in dev/staging to let the affiliate sync job use the mock adapter
# for merchants with no real per-network adapter yet. Leave unset in production —
# otherwise fabricated MOCK coupons get persisted as active API coupons.
AFFILIATE_MOCK_ADAPTERS_ENABLED="true"
