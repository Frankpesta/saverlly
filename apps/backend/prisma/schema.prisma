// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  KIOSK_OWNER
  LOCATION_MANAGER
}

enum KioskStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String? // shown in greetings instead of the email local-part once set; nullable since older rows predate this field
  avatarUrl          String? // profile photo, uploaded to /uploads/avatars; null falls back to initials
  passwordHash       String
  mustChangePassword Boolean        @default(true) // true for server-generated passwords; forces a change on next login
  role               UserRole
  kioskId            String? // null for ADMIN
  kiosk              Kiosk?         @relation(fields: [kioskId], references: [id])
  managedLocationIds String[] // used only for LOCATION_MANAGER role
  disabled           Boolean        @default(false)
  refreshTokenHash   String? // hashed current refresh token; cleared on logout, rotated on refresh
  notifications      Notification[]
  dismissedAlerts    DismissedAlert[]
  announcements      Announcement[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([kioskId])
}

model Kiosk {
  id                   String         @id @default(uuid())
  name                 String
  status               KioskStatus    @default(ACTIVE) // admin sets directly, no approval workflow
  revenueSharePct      Decimal        @db.Decimal(5, 2) // e.g. 30.00 = 30%
  stripeAccountId      String? // Stripe Connect Express account id, set once kiosk starts onboarding (Phase 5)
  stripePayoutsEnabled Boolean        @default(false) // synced from Stripe's account.updated webhook. True once onboarding is fully complete and the account can actually receive transfers
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  locations            Location[]
  users                User[]
  announcements        Announcement[]
  payouts              Payout[]
}

model Location {
  id                 String              @id @default(uuid())
  kioskId            String
  kiosk              Kiosk               @relation(fields: [kioskId], references: [id])
  name               String
  address            String
  city               String
  state              String
  zip                String? // US ZIP, ZIP+4, or a letter/dash postal code (e.g. Canadian). Validated by ZIP_PATTERN in create-location.dto.ts, deliberately a plain nullable string here so widening the accepted formats stays a validation-only change
  latitude           Float?
  longitude          Float?
  tags               String[] // e.g. ["mall", "downtown", "high-traffic"]. Used for future ad targeting
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  devices           Device[]
  locationSetupCode LocationSetupCode?

  @@index([kioskId])
}

// One setup code per location. Regenerating replaces the existing code in place rather than
// adding another row, so a location never has more than one code (active or otherwise) at once.
model LocationSetupCode {
  id         String   @id @default(uuid())
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id])
  code       String   @unique // short, human-enterable (e.g. 8 chars, unambiguous charset)
  active     Boolean  @default(true) // kiosk owner can revoke/reactivate
  createdAt  DateTime @default(now())
}

model Device {
  id                    String               @id @default(uuid())
  locationId            String
  location              Location             @relation(fields: [locationId], references: [id])
  label                 String // e.g. "Computer 4"
  active                Boolean              @default(true) // kill-switch. No approval needed to start, but can be disabled any time
  localDeviceIdentifier String? // agent-generated UUID from its local device.json, for support/audit correlation across re-registrations of the same physical machine
  osVersion             String? // e.g. "Windows 11 Pro 10.0.26200", reported by the agent at registration
  lastSeenAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deviceTokens          DeviceToken[]
  couponTestEvents      CouponTestEvent[]
  attributionAttempts   AttributionAttempt[]
  commissionEvents      CommissionEvent[]

  @@index([locationId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  tokenHash String   @unique // opaque, high-entropy token stored hashed. Never plaintext
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([deviceId])
}

enum CouponSource {
  API
  SCRAPE
  MANUAL
}

enum AttributionMethod {
  COOKIE
  URL_PARAM
  BOTH
}

model AffiliateProgram {
  id             String     @id @default(uuid())
  networkName    String // e.g. "Impact", "CJ Affiliate", "Rakuten". Nullable/omitted if merchant has no network, just a direct tracking link
  programId      String?
  apiCredentials String? // encrypted at rest (AES-256-GCM). Never store plaintext keys; null if no API available
  hasCouponApi   Boolean    @default(false) // explicit flag: this program can feed coupon codes automatically
  merchants      Merchant[]
  createdAt      DateTime   @default(now())
}

model Merchant {
  id                     String               @id @default(uuid())
  name                   String
  domain                 String               @unique // e.g. "target.com"
  affiliateProgramId     String?
  affiliateProgram       AffiliateProgram?    @relation(fields: [affiliateProgramId], references: [id])
  attributionMethod      AttributionMethod // required. Every merchant needs a tracking method to earn commission at all
  affiliateTrackingUrl   String? // base URL used to set the tracking cookie, if COOKIE or BOTH
  affiliateUrlParamKey   String? // query param name to append (e.g. "irclickid"), if URL_PARAM or BOTH
  affiliateUrlParamValue String? // the platform's own affiliate/tracking ID value to inject
  affiliateSubIdParamKey String? // optional pass-through sub-ID/click-ID query param name (e.g. Impact's "SubId1", CJ's "SID"). Null if the network doesn't support one; when set, a per-attribution-attempt value is minted and appended for commission attribution (Phase 5)
  active                 Boolean              @default(true)
  checkoutRecipe         Json? // see "Merchant Recipe". CouponFieldSelector, applyButtonSelector, etc.
  coupons                Coupon[]
  scrapeSources          ScrapeSource[]
  couponTestEvents       CouponTestEvent[]
  attributionAttempts    AttributionAttempt[]
  commissionEvents       CommissionEvent[]
  createdAt              DateTime             @default(now())

  @@index([affiliateProgramId])
}

model Coupon {
  id               String            @id @default(uuid())
  merchantId       String
  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  code             String
  description      String?
  source           CouponSource
  discountType     String? // "percent" | "fixed" | "unknown"
  discountValue    Float?
  successCount     Int               @default(0)
  failCount        Int               @default(0)
  lastTestedAt     DateTime?
  expiresAt        DateTime?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  couponTestEvents CouponTestEvent[]
  commissionEvents CommissionEvent[]

  @@unique([merchantId, code]) // dedup across sources. Repeat scrape/sync runs must upsert, never duplicate
}

model ScrapeSource {
  id              String    @id @default(uuid())
  url             String
  merchantId      String? // optional. Some scrape sources cover multiple merchants
  merchant        Merchant? @relation(fields: [merchantId], references: [id])
  selectorConfig  Json // CSS selectors for code extraction
  intervalMinutes Int       @default(1440) // schedule cadence, configurable per source. Default daily
  lastRunAt       DateTime?
  active          Boolean   @default(true)

  @@index([merchantId])
}

enum AnnouncementRepeatPolicy {
  ONCE
  EVERY_LOGIN
  MAX_N_TIMES
}

model Announcement {
  id              String                   @id @default(uuid())
  kioskId         String? // null = platform-wide broadcast (ADMIN-only); locationIds is always empty when null
  kiosk           Kiosk?                   @relation(fields: [kioskId], references: [id])
  locationIds     String[] // empty array = all locations for this kiosk (or, for a broadcast, everyone)
  /// Who wrote it. A location manager may edit and delete only their own announcements, never
  /// one the owner (or another manager) made for the same location. Nullable because
  /// announcements predating this column have no recorded author, and SetNull because deleting
  /// a team member must not take their live announcements off the kiosks with them.
  createdById     String?
  createdBy       User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title           String
  /// Internal note, for finding this announcement in the dashboard. Never drawn on the kiosk:
  /// what a kiosk shows comes entirely from `layout`. Nullable because it is optional to write.
  body            String?
  mediaUrl        String? // image/asset for the visual editor
  layout          Json? // freeform canvas design (AnnouncementLayout); null = pre-canvas announcement, agent falls back to a default layout built from title/body/mediaUrl
  startAt         DateTime
  endAt           DateTime
  repeatPolicy    AnnouncementRepeatPolicy @default(ONCE)
  maxDisplayCount Int? // used when repeatPolicy = MAX_N_TIMES
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([kioskId])
  @@index([createdById])
}

// Admin-authored promotion shown inside the Chrome extension's popup. Deliberately a separate
// model from Announcement rather than a `surface` enum on it. The two share almost nothing:
// different author (ADMIN vs kiosk owner), audience (end-shopper vs kiosk staff), display surface
// (extension popup vs the kiosk desktop overlay) and data shape (fixed image+link vs freeform
// layout). Folding them together would leave most columns null and meaningless on every row.
model Promotion {
  id            String   @id @default(uuid())
  name          String // internal label for the admin list. Never shown to shoppers
  imageSmallUrl String // 320x100, rendered in the extension popup today
  imageLargeUrl String // 728x90 leaderboard, held for the future injected on-page banner surface
  clickUrl      String // where the shopper lands when they click the promo
  // Targeting is a union, not an intersection: a promo shows if it matches EITHER the location's
  // tags OR its id. Both empty = show everywhere (the platform-wide case).
  targetTags    String[] // matched against Location.tags
  locationIds   String[] // specific locations, matched against Device.locationId
  startAt       DateTime
  endAt         DateTime
  active        Boolean  @default(true) // manual kill switch, independent of the schedule window
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, startAt, endAt])
}

model CouponTestEvent {
  id             String   @id @default(uuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id])
  couponId       String? // nullable, a step-down suppression event or a manual trigger with no matching coupon has no couponId
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  result         String // "applied" | "failed" | "suppressed_stepdown" | "no_coupons_available"
  discountAmount Decimal? @db.Decimal(10, 2) // only set when result = "applied", actual cart-total delta the extension confirmed, used for lifetime-savings totals
  createdAt      DateTime @default(now())

  @@index([deviceId])
  @@index([merchantId])
}

// Logged at the moment attribution tracking fires for a merchant with a sub-ID/click-ID
// pass-through param (Merchant.affiliateSubIdParamKey). Lets a later-reported network
// conversion be matched back to a device even though the network only ever echoes the
// subId, not our own internal ids. See 05-PHASE-5-commission-tracking.md "Attribution Logic".
model AttributionAttempt {
  id              String           @id @default(uuid())
  deviceId        String
  device          Device           @relation(fields: [deviceId], references: [id])
  merchantId      String
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  subId           String           @unique
  createdAt       DateTime         @default(now())
  commissionEvent CommissionEvent?

  @@index([deviceId])
  @@index([merchantId])
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  REVERSED
}

model CommissionEvent {
  id                 String              @id @default(uuid())
  deviceId           String
  device             Device              @relation(fields: [deviceId], references: [id])
  merchantId         String
  merchant           Merchant            @relation(fields: [merchantId], references: [id])
  couponId           String? // nullable, attribution-only sales (no coupon involved) are still valid commission events
  coupon             Coupon?             @relation(fields: [couponId], references: [id])
  subId              String?             @unique // the AttributionAttempt.subId this conversion was matched from. Nullable for a conversion reported with no recoverable sub-ID (orphaned, needs manual reconciliation)
  attributionAttempt AttributionAttempt? @relation(fields: [subId], references: [subId])
  networkReference   String // the affiliate network's own transaction/click ID, for reconciliation
  orderValue         Decimal             @db.Decimal(10, 2)
  commissionAmount   Decimal             @db.Decimal(10, 2) // total commission paid by network
  kioskShareAmount   Decimal             @db.Decimal(10, 2) // computed: commissionAmount * kiosk.revenueSharePct, finalized only on CONFIRMED
  status             CommissionStatus    @default(PENDING)
  reportedAt         DateTime
  confirmedAt        DateTime?
  reversedAt         DateTime?
  createdAt          DateTime            @default(now())
  payoutId           String? // set once included in a Payout's aggregation. Excluded from future aggregation runs
  payout             Payout?             @relation(fields: [payoutId], references: [id])

  @@unique([merchantId, networkReference]) // dedup. Repeat ingestion/reconciliation runs must upsert, never duplicate a network's own conversion record
  @@index([deviceId])
  @@index([merchantId])
  @@index([status])
  @@index([payoutId])
}

model Payout {
  id               String            @id @default(uuid())
  kioskId          String
  kiosk            Kiosk             @relation(fields: [kioskId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  totalAmount      Decimal           @db.Decimal(10, 2) // sum of CONFIRMED kioskShareAmount only, never includes pending
  status           String            @default("pending") // "pending" | "processing" | "paid" | "failed"
  stripeTransferId String?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  commissionEvents CommissionEvent[]

  @@index([kioskId])
}

enum NotificationType {
  KIOSK_OWNER_CREATED
  LOCATION_MANAGER_CREATED
  PAYOUT_PROCESSED
  STRIPE_ONBOARDING_CHANGED
  COMMISSION_DIGEST
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  metadata  Json? // e.g. { payoutId } / { enabled }. For future deep-linking, not rendered raw
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// The admin Overview "Needs attention" panel derives its items client-side from other tables
// (inactive kiosks, disabled devices, low coupon success rate, pending payouts) rather than
// having its own source of truth, so there's no row to mark done. This is what a user actually
// dismisses: alertKey is a stable id the frontend derives per item (e.g. "kiosk-inactive:<id>"),
// unique per user so a dismissal on one admin's screen doesn't hide it for another. Once the
// underlying condition resolves (kiosk re-activated, etc) the derived item simply stops being
// generated, so nothing here needs cleaning up on that path; a stale dismissal for a
// long-resolved alert is harmless dead weight, not a bug.
/// Runtime-editable platform configuration, so values an admin should be able to change (the
/// support address the kiosk portal points people at, for one) stop being build-time env vars
/// that need a redeploy. Deliberately a key/value table rather than a one-row settings model:
/// adding a setting is then a constant, not a migration.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DismissedAlert {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  alertKey  String
  createdAt DateTime @default(now())

  @@unique([userId, alertKey])
  @@index([userId])
}
