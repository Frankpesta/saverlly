  },
  "info": {
    "title": "Saverlly API",
    "description": "Multi-tenant SaaS platform for internet kiosk businesses — admin console, kiosk portal, and machine (Chrome extension / desktop agent) endpoints.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "device-token": {
        "scheme": "bearer",
        "bearerFormat": "device-token",
        "type": "http",
        "description": "Opaque device token issued at /devices/register — used by machine clients only."
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@kiosk.com"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateKioskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Downtown Internet Cafe"
          },
          "revenueSharePct": {
            "type": "number",
            "example": 30,
            "description": "Percentage of commission the kiosk keeps (0-100)"
          },
          "contactEmail": {
            "type": "string",
            "example": "owner@kiosk.com"
          }
        },
        "required": [
          "name",
          "revenueSharePct",
          "contactEmail"
        ]
      },
      "UpdateKioskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "revenueSharePct": {
            "type": "number",
            "description": "Percentage of commission the kiosk keeps (0-100)"
          },
          "contactEmail": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "UpdateKioskStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateKioskUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "KIOSK_OWNER",
              "LOCATION_MANAGER"
            ]
          },
          "managedLocationIds": {
            "description": "Location ids this user manages — only meaningful for LOCATION_MANAGER",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ]
      },
      "UpdateKioskUserDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "KIOSK_OWNER",
              "LOCATION_MANAGER"
            ]
          },
          "disabled": {
            "type": "boolean",
            "description": "Disable/re-enable this user account"
          },
          "managedLocationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateLocationDto": {
        "type": "object",
        "properties": {
          "kioskId": {
            "type": "string",
            "description": "Required when the caller is ADMIN; ignored for KIOSK_OWNER (their own kioskId is always used)"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "tags": {
            "example": [
              "mall",
              "downtown",
              "high-traffic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "address",
          "city",
          "state",
          "country"
        ]
      },
      "UpdateLocationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "tags": {
            "example": [
              "mall",
              "downtown",
              "high-traffic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateSetupCodeDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "description": "Set false to revoke the code, true to reactivate it"
          }
        },
        "required": [
          "active"
        ]
      },
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "setupCode": {
            "type": "string",
            "description": "Reusable per-location setup code generated by the kiosk owner/admin"
          },
          "label": {
            "type": "string",
            "example": "Computer 4"
          },
          "hostname": {
            "type": "string",
            "description": "Falls back to this if no label is given"
          }
        },
        "required": [
          "setupCode"
        ]
      },
      "UpdateDeviceDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "description": "Kill-switch — false immediately blocks this device's token"
          }
        }
      },
      "CreateAffiliateProgramDto": {
        "type": "object",
        "properties": {
          "networkName": {
            "type": "string",
            "example": "Impact",
            "description": "e.g. \"Impact\", \"CJ Affiliate\", \"Rakuten\""
          },
          "programId": {
            "type": "string"
          },
          "apiCredentials": {
            "type": "object",
            "description": "Raw credentials (e.g. { apiKey, apiSecret }) — encrypted before storage, never returned by any read endpoint",
            "additionalProperties": {
              "type": "string"
            }
          },
          "hasCouponApi": {
            "type": "boolean",
            "description": "Explicit flag: can this program feed coupon codes automatically?"
          }
        },
        "required": [
          "networkName",
          "hasCouponApi"
        ]
      },
      "UpdateAffiliateProgramDto": {
        "type": "object",
        "properties": {
          "networkName": {
            "type": "string"
          },
          "programId": {
            "type": "string"
          },
          "apiCredentials": {
            "type": "object",
            "description": "Replaces any existing stored credentials entirely — re-encrypted before storage",
            "additionalProperties": {
              "type": "string"
            }
          },
          "hasCouponApi": {
            "type": "boolean"
          }
        }
      },
      "CheckoutRecipeDto": {
        "type": "object",
        "properties": {
          "couponFieldSelector": {
            "type": "string",
            "example": "input[name='promoCode']"
          },
          "applyButtonSelector": {
            "type": "string",
            "example": "button[data-testid='apply-promo']"
          },
          "successIndicatorSelector": {
            "type": "string",
            "example": ".promo-success-message"
          },
          "failureIndicatorSelector": {
            "type": "string",
            "example": ".promo-error-message"
          },
          "cartTotalSelector": {
            "type": "string",
            "example": ".order-summary-total"
          },
          "checkoutUrlPatterns": {
            "example": [
              "/checkout",
              "/cart/checkout"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateMerchantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Target"
          },
          "domain": {
            "type": "string",
            "example": "target.com"
          },
          "attributionMethod": {
            "type": "string",
            "enum": [
              "COOKIE",
              "URL_PARAM",
              "BOTH"
            ],
            "description": "Required even if the store has no coupon API at all — this is what makes commission tracking work"
          },
          "affiliateTrackingUrl": {
            "type": "string",
            "description": "Required if attributionMethod is COOKIE or BOTH"
          },
          "affiliateUrlParamKey": {
            "type": "string",
            "example": "irclickid",
            "description": "Required if attributionMethod is URL_PARAM or BOTH"
          },
          "affiliateUrlParamValue": {
            "type": "string",
            "description": "Required if attributionMethod is URL_PARAM or BOTH"
          },
          "affiliateProgramId": {
            "type": "string",
            "description": "Optional coupon-sourcing config — connects this merchant to an existing affiliate program"
          },
          "checkoutRecipe": {
            "$ref": "#/components/schemas/CheckoutRecipeDto"
          }
        },
        "required": [
          "name",
          "domain",
          "attributionMethod"
        ]
      },
      "UpdateMerchantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "example": "target.com"
          },
          "attributionMethod": {
            "type": "string",
            "enum": [
              "COOKIE",
              "URL_PARAM",
              "BOTH"
            ]
          },
          "affiliateTrackingUrl": {
            "type": "string"
          },
          "affiliateUrlParamKey": {
            "type": "string",
            "example": "irclickid"
          },
          "affiliateUrlParamValue": {
            "type": "string"
          },
          "affiliateProgramId": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "checkoutRecipe": {
            "$ref": "#/components/schemas/CheckoutRecipeDto"
          }
        }
      },
      "CreateCouponDto": {
        "type": "object",
        "properties": {
          "merchantId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "SAVE20"
          },
          "description": {
            "type": "string"
          },
          "discountType": {
            "type": "string",
            "enum": [
              "percent",
              "fixed",
              "unknown"
            ]
          },
          "discountValue": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "merchantId",
          "code"
        ]
      },
      "UpdateCouponDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "discountType": {
            "type": "string",
            "enum": [
              "percent",
              "fixed",
              "unknown"
            ]
          },
          "discountValue": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "SelectorConfigDto": {
        "type": "object",
        "properties": {
          "codeSelector": {
            "type": "string",
            "description": "CSS selector matching each coupon code element on the page",
            "example": ".coupon-code"
          },
          "descriptionSelector": {
            "type": "string",
            "description": "CSS selector for a description near each code, if present"
          }
        },
        "required": [
          "codeSelector"
        ]
      },
      "CreateScrapeSourceDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "merchantId": {
            "type": "string",
            "description": "Leave unset only if this page cannot yet be attributed to one merchant"
          },
          "selectorConfig": {
            "$ref": "#/components/schemas/SelectorConfigDto"
          },
          "intervalMinutes": {
            "type": "number",
            "default": 1440,
            "description": "Scrape cadence in minutes — defaults to daily (1440)"
          }
        },
        "required": [
          "url",
          "selectorConfig"
        ]
      },
      "UpdateScrapeSourceDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "selectorConfig": {
            "$ref": "#/components/schemas/SelectorConfigDto"
          },
          "intervalMinutes": {
            "type": "number"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CreateCouponTestEventDto": {
        "type": "object",
        "properties": {
          "merchantId": {
            "type": "string"
          },
          "couponId": {
            "type": "string",
            "description": "Nullable — a step-down suppression or a manual trigger with no matching coupon has no couponId"
          },
          "result": {
            "type": "string",
            "enum": [
              "applied",
              "failed",
              "suppressed_stepdown",
              "no_coupons_available"
            ]
          }
        },
        "required": [
          "merchantId",
          "result"
        ]
      }
    }
  }
}