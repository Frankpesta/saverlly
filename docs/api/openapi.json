          },
          "409": {
            "description": "This merchant already has a coupon with this code"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "Manually add a coupon code for a merchant",
        "tags": [
          "Coupons"
        ]
      },
      "get": {
        "operationId": "CouponsController_findAll",
        "parameters": [
          {
            "name": "merchantId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Coupons"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "List coupons, optionally filtered by merchantId",
        "tags": [
          "Coupons"
        ]
      }
    },
    "/coupons/{id}": {
      "patch": {
        "operationId": "CouponsController_update",
