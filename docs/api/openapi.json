              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded"
          },
          "401": {
            "description": "Invalid credentials, or account disabled"
          }
        },
        "summary": "Log in with email + password, get an access/refresh token pair",
