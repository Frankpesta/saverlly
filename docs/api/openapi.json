        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "Update a coupon",
        "tags": [
          "Coupons"
        ]
      },
      "delete": {
        "operationId": "CouponsController_remove",
        "parameters": [
          {
            "name": "id",
