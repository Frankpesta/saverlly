        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScrapeSourceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scrape source created and scheduled"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "Add a scrape source (URL + selector config), scheduled on creation",
        "tags": [
          "Scrape Sources"
        ]
      },
      "get": {
        "operationId": "ScrapeSourcesController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Scrape sources"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "List all scrape sources",
        "tags": [
          "Scrape Sources"
        ]
      }
    },
    "/scrape-sources/{id}": {
      "patch": {
        "operationId": "ScrapeSourcesController_update",
