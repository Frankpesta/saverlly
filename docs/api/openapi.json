        "responses": {
          "200": {
            "description": "A fresh token pair; the old refresh token is now invalid"
          },
          "401": {
            "description": "Invalid, expired, or already-rotated refresh token"
          }
        },
        "summary": "Exchange a refresh token for a new access/refresh token pair",
        "tags": [
          "Auth"
        ]
      }
    },
