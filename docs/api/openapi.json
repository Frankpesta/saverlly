            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Coupon deleted"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ],
        "summary": "Delete a coupon",
        "tags": [
          "Coupons"
        ]
      }
    },
    "/scrape-sources": {
      "post": {
        "operationId": "ScrapeSourcesController_create",
