  "info": {
    "title": "Saverlly API",
    "description": "Multi-tenant SaaS platform for internet kiosk businesses — admin console, kiosk portal, and machine (Chrome extension / desktop agent) endpoints.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "device-token": {
        "scheme": "bearer",
        "bearerFormat": "device-token",
        "type": "http",
        "description": "Opaque device token issued at /devices/register — used by machine clients only."
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@kiosk.com"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateKioskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Downtown Internet Cafe"
          },
          "revenueSharePct": {
            "type": "number",
            "example": 30,
            "description": "Percentage of commission the kiosk keeps (0-100)"
          },
          "contactEmail": {
            "type": "string",
            "example": "owner@kiosk.com"
          }
        },
        "required": [
          "name",
          "revenueSharePct",
          "contactEmail"
        ]
      },
      "UpdateKioskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "revenueSharePct": {
            "type": "number",
            "description": "Percentage of commission the kiosk keeps (0-100)"
          },
          "contactEmail": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "UpdateKioskStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateKioskUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "KIOSK_OWNER",
              "LOCATION_MANAGER"
            ]
          },
          "managedLocationIds": {
            "description": "Location ids this user manages — only meaningful for LOCATION_MANAGER",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ]
      },
      "UpdateKioskUserDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "KIOSK_OWNER",
              "LOCATION_MANAGER"
            ]
          },
          "disabled": {
            "type": "boolean",
            "description": "Disable/re-enable this user account"
          },
          "managedLocationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateLocationDto": {
        "type": "object",
        "properties": {
          "kioskId": {
            "type": "string",
            "description": "Required when the caller is ADMIN; ignored for KIOSK_OWNER (their own kioskId is always used)"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "tags": {
            "example": [
              "mall",
              "downtown",
              "high-traffic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "address",
          "city",
          "state",
          "country"
        ]
      },
      "UpdateLocationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "tags": {
            "example": [
              "mall",
              "downtown",
              "high-traffic"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateSetupCodeDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "description": "Set false to revoke the code, true to reactivate it"
